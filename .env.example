# DFS OPTIMIZER ENVIRONMENT CONFIGURATION (v6)
# Copy this file to .env and replace placeholders with your actual values.
# NEVER commit .env files to version control.

# ============================================================================
# API KEYS
# ============================================================================
# FantasyPros API key (projections / rankings)
FANTASYPROS_API_KEY=

# Anthropic Claude — the only AI provider used in v6 (Claude-only).
ANTHROPIC_API_KEY=

# The Odds API key (Vegas lines integration).
# NOTE: rotate this — old keys were leaked in chat. Generate a fresh free key
# at https://the-odds-api.com before use.
ODDS_API_KEY=

# ============================================================================
# AI BUDGET & USAGE CONTROLS
# ============================================================================
# Weekly AI spend cap (USD).
AI_WEEKLY_BUDGET_USD=10

# Rate limiting for AI calls.
MAX_AI_CALLS_PER_HOUR=100

# AI analysis triggers.
AI_ANALYSIS_ENABLED=true
AI_NEWS_ANALYSIS=true
AI_LATE_SWAP_ANALYSIS=true

# ============================================================================
# SYSTEM CONFIGURATION
# ============================================================================
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Database URLs
DATABASE_URL=sqlite:///dfs_optimizer.db
REDIS_URL=redis://localhost:6379

# API Configuration
API_HOST=0.0.0.0
API_PORT=8020

# ============================================================================
# OPTIMIZATION SETTINGS
# ============================================================================
# Update intervals (minutes)
UPDATE_INTERVAL=300
OPTIMIZATION_THREADS=4

# Cache settings (seconds)
CACHE_TTL=600
AI_CACHE_TTL=1800

# Weekly cadence settings
WEDNESDAY_BUILD_TIME=09:00
SUNDAY_FINALIZE_TIME=11:30
LATE_SWAP_TIMES=14:15,15:45

# ============================================================================
# CONTEST STRATEGY WEIGHTS
# ============================================================================
# GPP/Tournament strategy
GPP_VARIANCE_WEIGHT=0.3
GPP_OWNERSHIP_THRESHOLD=25.0
GPP_CORRELATION_MIN=0.4

# Cash game strategy
CASH_VARIANCE_WEIGHT=-0.1
CASH_OWNERSHIP_THRESHOLD=40.0
CASH_CORRELATION_MIN=0.2

# Contrarian strategy
CONTRARIAN_VARIANCE_WEIGHT=0.4
CONTRARIAN_OWNERSHIP_THRESHOLD=15.0
CONTRARIAN_CORRELATION_MIN=0.5

# Single game strategy
SINGLE_GAME_VARIANCE_WEIGHT=0.2
SINGLE_GAME_OWNERSHIP_THRESHOLD=25.0
SINGLE_GAME_MVP_BOOST=1.5

# ============================================================================
# LATE SWAP CONFIGURATION
# ============================================================================
AUTO_LATE_SWAP_ENABLED=true
LATE_SWAP_MIN_IMPROVEMENT=1.0
MAX_LATE_SWAPS_PER_DAY=3
LATE_SWAP_ALTERNATIVES=5

# ============================================================================
# DATA SOURCE PREFERENCES
# ============================================================================
# Free data sources (recommended)
USE_NFL_DATA_PY=true
USE_ESPN_HIDDEN_APIS=true
USE_WEATHER_GOV=true
USE_SLEEPER_API=true

# Paid/premium sources (optional)
USE_FANTASYPROS_PREMIUM=false
USE_PAID_PROJECTIONS=false

# ============================================================================
# NOTIFICATION SETTINGS
# ============================================================================
# Discord webhook for notifications (optional)
DISCORD_WEBHOOK_URL=

# Email notifications (optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=
EMAIL_PASS=
NOTIFICATION_EMAIL=

# ============================================================================
# PRODUCTION OVERRIDES
# ============================================================================
# ENVIRONMENT=production
# DEBUG=False
# LOG_LEVEL=WARNING
# API_PORT=80

# ============================================================================
# SECURITY NOTES
# ============================================================================
# 1. Never commit .env files to version control.
# 2. Regularly rotate API keys (especially ODDS_API_KEY — see note above).
# 3. Monitor API usage and costs against AI_WEEKLY_BUDGET_USD.

# ============================================================================
# GETTING STARTED
# ============================================================================
# 1. Copy this file:  cp .env.example .env
# 2. Add your API keys (system runs on free data sources with none set;
#    AI analysis is skipped without ANTHROPIC_API_KEY).
# 3. Run:   python main.py web
# 4. Visit: http://localhost:8020
#
# NOTE: FanDuel salary CSV is a MANUAL download — there is no FanDuel scraping
# or FanDuel credentials in v6.
