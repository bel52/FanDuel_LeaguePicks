# DFS OPTIMIZER ENVIRONMENT CONFIGURATION
# Copy this file to .env and replace placeholders with your actual values
# NEVER commit .env files to version control

# ============================================================================
# API KEYS (Optional but recommended for enhanced analysis)
# ============================================================================
OPENAI_API_KEY=your_openai_api_key_here
# Optionally specify a model (default is gpt-4o-mini for cost efficiency)
GPT_MODEL=gpt-4o-mini

# Anthropic Claude (alternative AI provider)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================================================
# DATA SOURCE CREDENTIALS (Optional)
# ============================================================================
# FantasyPros credentials for scraping (if CSV not provided)
FANTASYPROS_USER=your_fp_username
FANTASYPROS_PASS=your_fp_password

# The Odds API Key (for Vegas lines integration)
ODDS_API_KEY=your_odds_api_key

# FanDuel credentials (for salary scraping - use at your own risk)
FANDUEL_USERNAME=your_fd_username
FANDUEL_PASSWORD=your_fd_password

# ============================================================================
# SYSTEM CONFIGURATION
# ============================================================================
# Environment mode
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Database URLs
DATABASE_URL=sqlite:///dfs_optimizer.db
REDIS_URL=redis://localhost:6379

# API Configuration
API_HOST=0.0.0.0
API_PORT=8020

# ============================================================================
# OPTIMIZATION SETTINGS
# ============================================================================
# Update intervals (minutes)
UPDATE_INTERVAL=300
OPTIMIZATION_THREADS=4

# Cache settings (seconds)
CACHE_TTL=600
AI_CACHE_TTL=1800

# Weekly cadence settings
WEDNESDAY_BUILD_TIME=09:00
SUNDAY_FINALIZE_TIME=11:30
LATE_SWAP_TIMES=14:15,15:45

# ============================================================================
# CONTEST STRATEGY WEIGHTS
# ============================================================================
# GPP/Tournament strategy
GPP_VARIANCE_WEIGHT=0.3
GPP_OWNERSHIP_THRESHOLD=25.0
GPP_CORRELATION_MIN=0.4

# Cash game strategy  
CASH_VARIANCE_WEIGHT=-0.1
CASH_OWNERSHIP_THRESHOLD=40.0
CASH_CORRELATION_MIN=0.2

# Contrarian strategy
CONTRARIAN_VARIANCE_WEIGHT=0.4
CONTRARIAN_OWNERSHIP_THRESHOLD=15.0
CONTRARIAN_CORRELATION_MIN=0.5

# Single game strategy
SINGLE_GAME_VARIANCE_WEIGHT=0.2
SINGLE_GAME_OWNERSHIP_THRESHOLD=25.0
SINGLE_GAME_MVP_BOOST=1.5

# ============================================================================
# LATE SWAP CONFIGURATION
# ============================================================================
# Enable automated late swap functionality
AUTO_LATE_SWAP_ENABLED=true

# Minimum expected value improvement to trigger swap (points)
LATE_SWAP_MIN_IMPROVEMENT=1.0

# Maximum number of late swaps per day
MAX_LATE_SWAPS_PER_DAY=3

# Late swap analysis depth
LATE_SWAP_ALTERNATIVES=5

# ============================================================================
# AI BUDGET & USAGE CONTROLS
# ============================================================================
# Weekly AI budget (USD)
AI_WEEKLY_BUDGET=1.00

# Rate limiting for AI calls
MAX_AI_CALLS_PER_HOUR=100

# AI analysis triggers
AI_ANALYSIS_ENABLED=true
AI_NEWS_ANALYSIS=true
AI_LATE_SWAP_ANALYSIS=true

# ============================================================================
# DATA SOURCE PREFERENCES
# ============================================================================
# Enable free data sources (recommended)
USE_NFL_DATA_PY=true
USE_ESPN_HIDDEN_APIS=true
USE_WEATHER_GOV=true
USE_SLEEPER_API=true

# Enable paid/premium sources (optional)
USE_FANTASYPROS_PREMIUM=false
USE_PAID_PROJECTIONS=false

# ============================================================================
# NOTIFICATION SETTINGS
# ============================================================================
# Discord webhook for notifications (optional)
DISCORD_WEBHOOK_URL=your_discord_webhook_url

# Email notifications (optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
NOTIFICATION_EMAIL=your_notification_email@gmail.com

# ============================================================================
# PRODUCTION OVERRIDES
# ============================================================================
# Set these for production deployment
# ENVIRONMENT=production
# DEBUG=False
# LOG_LEVEL=WARNING
# API_HOST=0.0.0.0
# API_PORT=80

# ============================================================================
# SECURITY NOTES
# ============================================================================
# 1. Never commit .env files to version control
# 2. Use strong, unique passwords for all accounts
# 3. Regularly rotate API keys
# 4. Monitor API usage and costs
# 5. Use read-only credentials where possible
# 6. Enable 2FA on all external accounts

# ============================================================================
# GETTING STARTED
# ============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Replace placeholders with real values (at minimum, no keys required to start)
# 3. Run: python main.py web
# 4. Visit: http://localhost:8020
# 5. Optional: Add API keys for enhanced features

# Minimal setup - no API keys required:
# Just run with the default placeholder values above
# The system will use free data sources and skip AI analysis

# Enhanced setup - add these for full features:
# - OPENAI_API_KEY for AI-powered analysis (~$0.10/week)
# - ODDS_API_KEY for Vegas lines integration
# - Other keys as needed for your specific use case
