# === Example env file (placeholders only; DO NOT PUT REAL KEYS HERE) ===
# Copy to .env and fill with your real values. Never commit .env.

# API Keys
OPENAI_API_KEY=YOUR_OPENAI_KEY
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY
NEWS_API_KEY=YOUR_NEWSAPI_KEY
ODDS_API_KEY=YOUR_ODDSAPI_KEY

# Redis (container)
REDIS_URL=redis://redis:6379

# Strategy and AI settings (you can tweak in .env)
HTH_STRATEGY_WEIGHT=0.3
LEAGUE_STRATEGY_WEIGHT=0.5
MAX_SWAPS_PER_DAY=3
AUTO_SWAP_ENABLED=true
GPT_MODEL=gpt-4o-mini
AI_CACHE_TTL=1800
MAX_AI_CALLS_PER_HOUR=100
