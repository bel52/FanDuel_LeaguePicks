import re

# Find the _process_player_data method and ADD these new methods AFTER it

    def _normalize_player_name(self, name: str) -> str:
import re
        """Normalize player names for matching between data sources"""
        if not name:
            return ""
        
        # Remove suffixes, normalize spacing
        name = re.sub(r'\s+(Jr\.?|Sr\.?|III|IV|V)$', '', name, flags=re.IGNORECASE)
        name = re.sub(r'\s+', ' ', name.strip())
        
        # Common name variations
        name_mappings = {
            'Josh Gordon': 'Joshua Gordon',
            'DJ Moore': 'D.J. Moore',
            'AJ Brown': 'A.J. Brown',
            'CJ Stroud': 'C.J. Stroud',
        }
        
        return name_mappings.get(name, name).lower()

    def _process_player_data_with_salaries(self, nfl_data, salary_data, teams: set) -> List[Dict]:
        """Enhanced version that merges with FanDuel salaries"""
        players = []
        
        # Create salary lookup
        salary_lookup = {}
        if hasattr(salary_data, 'iterrows') and not salary_data.empty:
            for _, row in salary_data.iterrows():
                key = self._normalize_player_name(row.get('Name', ''))
                salary_lookup[key] = {
                    'salary': int(row.get('Salary', 5000)),
                    'position': row.get('Position', ''),
                    'team': row.get('Team', '').upper()
                }
        
        logger.info(f"💰 Created salary lookup for {len(salary_lookup)} players")
        
        for _, row in nfl_data.iterrows():
            try:
                team = row.get('recent_team', '').upper()
                if team not in teams:
                    continue
                
                player_name = row.get('player_name', '')
                normalized_name = self._normalize_player_name(player_name)
                projection = self._calculate_projection(row)
                
                # Get FanDuel salary or estimate
                if normalized_name in salary_lookup:
                    salary_info = salary_lookup[normalized_name]
                    salary = salary_info['salary']
                    logger.debug(f"✅ Found FD salary for {player_name}: ${salary}")
                else:
                    # Estimate salary if not found
                    position = row.get('position', '')
                    salary = self._estimate_salary(position, projection)
                    logger.debug(f"📈 Estimated salary for {player_name}: ${salary}")
                
                player = {
                    'player_id': row.get('player_id', ''),
                    'player_name': player_name,
                    'name': player_name,
                    'position': row.get('position', ''),
                    'team': team,
                    'projection': max(0, projection),
                    'salary': salary,
                    'value': projection / (salary / 1000) if salary > 0 else 0,
                    'week': int(row.get('week', 0)),
                    'source': 'fanduel_salary' if normalized_name in salary_lookup else 'estimated'
                }
                
                players.append(player)
                
            except Exception as e:
                logger.warning(f"Error processing player: {e}")
                continue
        
        return players

    def _estimate_projection_from_salary(self, salary: int, position: str) -> float:
        """Estimate fantasy projection based on FanDuel salary"""
        salary_ratios = {
            'QB': 0.0025, 'RB': 0.002, 'WR': 0.002,
            'TE': 0.0018, 'K': 0.0015, 'DST': 0.0018
        }
        
        ratio = salary_ratios.get(position, 0.002)
        projection = salary * ratio
        
        # Add bounds
        if position == 'QB':
            projection = max(12, min(35, projection))
        elif position in ['RB', 'WR']:
            projection = max(6, min(30, projection))
        elif position == 'TE':
            projection = max(4, min(25, projection))
        else:
            projection = max(4, min(15, projection))
        
        return projection

# REPLACE the existing collect_players_for_slate method with this enhanced version
    async def collect_players_for_slate(self, games_info: Dict[str, Any], contest_type: str = 'gpp') -> List[Dict]:
        """Collect players filtered by contest type and slate WITH FanDuel salaries"""
        current_week = games_info['current_week']
        
        # Determine which teams to include
        if contest_type == 'single_game':
            playing_teams = set()
            for game in games_info['single_games']:
                playing_teams.update(game['teams'])
        else:
            playing_teams = set()
            for game in games_info['main_slate']:
                playing_teams.update(game['teams'])
        
        logger.info(f"Collecting players for {contest_type}: {len(playing_teams)} teams playing")
        
        # Get FanDuel salaries FIRST
        salary_data = None
        try:
            from fanduel_salary_scraper import get_fanduel_salaries
            salary_data = await get_fanduel_salaries()
            logger.info(f"📊 Retrieved {len(salary_data)} FanDuel salary entries")
        except Exception as e:
            logger.error(f"Failed to get FanDuel salaries: {e}")
            import pandas as pd
            salary_data = pd.DataFrame()
        
        # Get NFL projection data
        try:
            await self.rate_limiters['nfl_data'].acquire()
            weekly_data = nfl.import_weekly_data([2024])
            
            if not weekly_data.empty:
                # Filter for current week and relevant teams
                relevant_data = weekly_data[
                    (weekly_data['week'] == current_week) & 
                    (weekly_data['recent_team'].isin(playing_teams))
                ].copy()
                
                # If insufficient data, include recent weeks
                if len(relevant_data) < 50:
                    recent_weeks = [current_week - 1, current_week - 2]
                    backup_data = weekly_data[
                        (weekly_data['week'].isin(recent_weeks)) & 
                        (weekly_data['recent_team'].isin(playing_teams))
                    ]
                    relevant_data = pd.concat([relevant_data, backup_data]).drop_duplicates('player_id')
                
                # Use enhanced processing with salaries
                if hasattr(salary_data, 'empty') and not salary_data.empty:
                    players = self._process_player_data_with_salaries(relevant_data, salary_data, playing_teams)
                else:
                    players = self._process_player_data(relevant_data, playing_teams)
            else:
                players = self._generate_fallback_players(playing_teams)
                
        except Exception as e:
            logger.error(f"Error collecting NFL data: {e}")
            players = self._generate_fallback_players(playing_teams)
        
        # Ensure complete rosters
        players = self._ensure_complete_rosters(players, playing_teams)
        
        logger.info(f"Collected {len(players)} players for {contest_type}")
        return players
