"""
Enhanced DFS lineup optimization with proper contest type differentiation
Ensures different strategies for tournament, cash, and contrarian lineups
"""
import pulp
import pandas as pd
import numpy as np
from typing import List, Dict, Any, Optional, Tuple
from dataclasses import dataclass
from loguru import logger
import itertools
from sklearn.ensemble import RandomForestRegressor
import json
import random

from config import FANDUEL_POSITIONS, FANDUEL_SALARY_CAP, OPTIMIZATION_CONFIG, SINGLE_GAME_POSITIONS

@dataclass
class Player:
    """Player data structure for optimization"""
    id: str
    name: str
    position: str
    team: str
    salary: int
    projection: float
    ownership: float = 10.0  # Default ownership percentage
    weather_factor: float = 1.0  # Weather adjustment factor
    injury_risk: float = 0.0  # Injury risk score (0-1)
    value: float = 0.0
    variance: float = 0.0  # Projection variance for ceiling/floor calculations
    
    def __post_init__(self):
        self.value = self.projection / (self.salary / 1000) if self.salary > 0 else 0
        # Estimate variance based on position
        variance_multipliers = {'QB': 0.3, 'RB': 0.4, 'WR': 0.5, 'TE': 0.4, 'K': 0.6, 'DST': 0.5}
        self.variance = self.projection * variance_multipliers.get(self.position, 0.4)

@dataclass
class LineupResult:
    """Optimization result structure"""
    players: List[Player]
    total_salary: int
    projected_points: float
    total_value: float
    ownership_total: float
    correlation_score: float
    weather_impact: float
    contest_type: str
    ceiling_score: float = 0.0
    floor_score: float = 0.0

class EnhancedCorrelationMatrix:
    """Manages player correlations with game-specific logic"""
    
    def __init__(self):
        # Base correlation coefficients from research
        self.base_correlations = {
            ('QB', 'WR'): 0.62,
            ('QB', 'TE'): 0.32,
            ('QB', 'RB'): 0.08,
            ('RB', 'WR'): -0.05,
            ('WR', 'WR'): -0.15,  # Same team WRs compete
            ('QB', 'DST'): -0.41,  # QB vs opposing defense
            ('RB', 'DST'): 0.25   # Game script correlation
        }
        
    def get_correlation(self, player1: Player, player2: Player, game_context: Dict = None) -> float:
        """Calculate correlation between two players with context"""
        # Same team positive correlation for passing game
        if (player1.team == player2.team and 
            player1.position == 'QB' and player2.position in ['WR', 'TE']):
            base_corr = self.base_correlations[('QB', player2.position)]
            
            # Boost correlation in high-total games
            if game_context and game_context.get('game_total', 0) > 47:
                base_corr *= 1.1
            
            return base_corr
        
        # Opposing team correlations (bring-back stacks)
        if (player1.team != player2.team and 
            player1.position in ['QB', 'WR', 'TE'] and 
            player2.position in ['QB', 'WR', 'TE']):
            if game_context and game_context.get('game_total', 0) > 50:
                return 0.15  # Positive correlation in shootouts
        
        # QB vs opposing DST
        if ((player1.position == 'QB' and player2.position == 'DST' and player1.team != player2.team) or
            (player2.position == 'QB' and player1.position == 'DST' and player2.team != player1.team)):
            return self.base_correlations[('QB', 'DST')]
        
        # Same position negative correlation
        if (player1.position == player2.position and player1.team == player2.team and
            player1.position in ['WR', 'RB']):
            return self.base_correlations.get((player1.position, player2.position), -0.1)
        
        return 0.0

class ContestSpecificOwnershipProjector:
    """Projects ownership with contest-specific adjustments"""
    
    def __init__(self):
        self.model = RandomForestRegressor(n_estimators=50, random_state=42)
        self.is_trained = False
    
    def predict_ownership(self, player: Player, contest_type: str = 'gpp') -> float:
        """Predict ownership with contest-specific logic"""
        base_ownership = self._calculate_base_ownership(player)
        
        # Contest-specific adjustments
        if contest_type == 'gpp':
            # Tournament: Higher ownership for chalk plays
            if player.value > 3.0:  # High value = likely chalk
                base_ownership *= 1.3
            if player.salary > 9000:  # Expensive studs get more ownership
                base_ownership *= 1.2
                
        elif contest_type == 'cash':
            # Cash games: More balanced ownership
            base_ownership *= 0.9  # Slightly lower overall
            if player.value > 3.5:  # Safe, high-value plays
                base_ownership *= 1.1
                
        elif contest_type == 'contrarian':
            # Contrarian: Reverse the chalk logic
            if player.value > 3.0:
                base_ownership *= 0.6  # Heavily fade chalk
            if player.salary < 6000:  # Cheap players often overlooked
                base_ownership *= 0.7
        
        return max(1.0, min(50.0, base_ownership))
    
    def _calculate_base_ownership(self, player: Player) -> float:
        """Calculate base ownership from player attributes"""
        # Salary-based baseline
        salary_factor = min(player.salary / 300, 35)
        
        # Value adjustment
        value_factor = max(0.5, player.value - 1.5) * 5
        
        # Position adjustment
        position_multipliers = {
            'QB': 1.0, 'RB': 1.1, 'WR': 1.0, 'TE': 0.8, 'K': 0.6, 'DST': 0.7
        }
        position_factor = position_multipliers.get(player.position, 1.0)
        
        return (salary_factor + value_factor) * position_factor

class EnhancedDFSOptimizer:
    """Enhanced DFS optimization with proper contest differentiation"""
    
    def __init__(self):
        self.correlation_matrix = EnhancedCorrelationMatrix()
        self.ownership_projector = ContestSpecificOwnershipProjector()
        
    def prepare_players(self, player_data: List[Dict], weather_data: Dict = None) -> List[Player]:
        """Convert raw player data to Player objects with enhanced attributes"""
        players = []
        
        for data in player_data:
            try:
                # Create base player
                player = Player(
                    id=str(data.get('player_id', data.get('name', ''))),
                    name=data.get('player_name', data.get('name', '')),
                    position=data.get('position', ''),
                    team=data.get('team', ''),
                    salary=int(data.get('salary', 5000)),
                    projection=float(data.get('projection', data.get('fantasy_points_ppr', 0)))
                )
                
                # Apply weather adjustments (already in original code)
                if weather_data and player.team in weather_data:
                    team_weather = weather_data[player.team]
                    weather_impact = self._calculate_weather_impact(player, team_weather)
                    player.weather_factor = weather_impact
                    player.projection *= weather_impact
                
                # Recalculate value after adjustments
                player.value = player.projection / (player.salary / 1000) if player.salary > 0 else 0
                
                players.append(player)
                
            except Exception as e:
                logger.error(f"Error processing player {data}: {e}")
                continue
        
        logger.info(f"Prepared {len(players)} players for optimization")
        return players
    
    def _calculate_weather_impact(self, player: Player, weather_data: Dict) -> float:
        """Calculate weather impact on player performance"""
        adjustment = 1.0
        forecast = weather_data.get('forecast', {})
        
        # Extract weather conditions
        wind_speed = self._extract_wind_speed(forecast)
        temperature = self._extract_temperature(forecast)
        has_precipitation = self._has_precipitation(forecast)
        
        # Position-specific weather sensitivity
        if player.position == 'QB':
            if wind_speed >= 15:
                adjustment *= 0.85
            if temperature <= 32:
                adjustment *= 0.90
            if has_precipitation:
                adjustment *= 0.92
        elif player.position in ['WR', 'TE']:
            if wind_speed >= 15:
                adjustment *= 0.88
            if has_precipitation:
                adjustment *= 0.90
        elif player.position == 'RB':
            if has_precipitation:
                adjustment *= 1.05  # RBs benefit from bad weather
        elif player.position == 'K':
            if wind_speed >= 15:
                adjustment *= 0.75  # Kickers heavily affected by wind
        elif player.position == 'DST':
            if has_precipitation or wind_speed >= 15:
                adjustment *= 1.08  # Defense benefits from bad weather
        
        return max(0.5, adjustment)
    
    def _extract_wind_speed(self, forecast: Dict) -> float:
        """Extract wind speed from forecast data"""
        detail_forecast = forecast.get('detailedForecast', '').lower()
        wind_info = forecast.get('windSpeed', '').lower()
        
        # Look for wind speeds
        import re
        wind_pattern = r'(\d+).*?mph'
        matches = re.findall(wind_pattern, wind_info + ' ' + detail_forecast)
        
        if matches:
            return float(matches[0])
        return 5.0  # Default light wind
    
    def _extract_temperature(self, forecast: Dict) -> float:
        """Extract temperature from forecast data"""
        temp = forecast.get('temperature', 70)
        return float(temp) if temp else 70.0
    
    def _has_precipitation(self, forecast: Dict) -> bool:
        """Check if precipitation is expected"""
        detail_forecast = forecast.get('detailedForecast', '').lower()
        precip_keywords = ['rain', 'snow', 'sleet', 'storm', 'shower', 'drizzle']
        return any(keyword in detail_forecast for keyword in precip_keywords)
    
    def optimize_lineup(self, 
                       players: List[Player], 
                       contest_type: str = 'gpp',
                       avoid_high_ownership: bool = True,
                       force_stacks: bool = True,
                       single_game_teams: List[str] = None) -> Optional[LineupResult]:
        """Optimize lineup with contest-specific strategies"""
        
        try:
            # Filter players for single game contests
            if single_game_teams:
                players = [p for p in players if p.team in single_game_teams]
                if len(players) < 6:
                    logger.error(f"Not enough players ({len(players)}) for single game from teams: {single_game_teams}")
                    return None
            
            # Project ownership based on contest type
            for player in players:
                player.ownership = self.ownership_projector.predict_ownership(player, contest_type)
            
            # Create optimization problem
            prob = pulp.LpProblem("DFS_Lineup_Optimization", pulp.LpMaximize)
            
            # Decision variables
            player_vars = {}
            for i, player in enumerate(players):
                player_vars[i] = pulp.LpVariable(f"player_{i}", cat='Binary')
            
            # Contest-specific objective function
            objective_terms = []
            for i, player in enumerate(players):
                points_value = self._calculate_contest_specific_value(player, contest_type, avoid_high_ownership)
                objective_terms.append(points_value * player_vars[i])
            
            prob += pulp.lpSum(objective_terms)
            
            # Add constraints based on contest type
            self._add_contest_specific_constraints(prob, players, player_vars, contest_type, 
                                                 force_stacks, single_game_teams)
            
            # Solve the problem
            prob.solve(pulp.PULP_CBC_CMD(msg=0))
            
            if prob.status == pulp.LpStatusOptimal:
                return self._extract_lineup_result(prob, players, player_vars, contest_type)
            else:
                logger.warning(f"Optimization failed with status: {pulp.LpStatus[prob.status]}")
                return None
                
        except Exception as e:
            logger.error(f"Error in lineup optimization: {e}")
            return None
    
    def _calculate_contest_specific_value(self, player: Player, contest_type: str, avoid_high_ownership: bool) -> float:
        """Calculate contest-specific player value"""
        base_value = player.projection
        
        if contest_type == 'gpp':
            # Tournament: Maximize ceiling, consider ownership leverage
            ceiling_bonus = player.variance * 0.3  # Reward variance
            base_value += ceiling_bonus
            
            if avoid_high_ownership:
                # Penalty for very high ownership
                if player.ownership > 25:
                    ownership_penalty = (player.ownership - 25) * 0.08
                    base_value -= ownership_penalty
                # Bonus for low ownership with high upside
                elif player.ownership < 8 and player.projection > 12:
                    base_value += 1.5
            
        elif contest_type == 'cash':
            # Cash games: Prioritize floor and consistency
            floor_bonus = max(0, player.projection - player.variance) * 0.1
            base_value += floor_bonus
            
            # Heavy penalty for very low ownership (risky plays)
            if player.ownership < 5:
                base_value *= 0.85
            # Bonus for solid, reliable plays
            elif 10 <= player.ownership <= 30 and player.value > 2.8:
                base_value *= 1.05
                
        elif contest_type == 'contrarian':
            # Contrarian: Heavy ownership penalties, ceiling chasing
            ceiling_bonus = player.variance * 0.4
            base_value += ceiling_bonus
            
            # Heavy penalty for chalk
            if player.ownership > 20:
                ownership_penalty = (player.ownership - 20) * 0.15
                base_value -= ownership_penalty
            # Big bonus for low ownership
            elif player.ownership < 8:
                base_value += 2.0
            
        elif contest_type == 'single_game':
            # Single game: Prioritize correlation and game script
            if player.position in ['QB', 'WR', 'TE']:
                base_value *= 1.1  # Passing game correlation
            # MVP consideration (highest projection gets bonus)
            max_proj = max(p.projection for p in [player])  # Would need full player list
            if player.projection >= max_proj * 0.9:
                base_value += 3.0  # MVP bonus
        
        return base_value
    
    def _add_contest_specific_constraints(self, prob, players: List[Player], player_vars: Dict,
                                        contest_type: str, force_stacks: bool, single_game_teams: List[str]):
        """Add contest and format specific constraints"""
        
        # Salary cap constraint (universal)
        prob += pulp.lpSum([players[i].salary * player_vars[i] for i in range(len(players))]) <= FANDUEL_SALARY_CAP
        
        if single_game_teams:
            # Single Game format: 6 players total (1 MVP + 5 FLEX)
            prob += pulp.lpSum([player_vars[i] for i in range(len(players))]) == 6
            
            # Ensure players are only from the specified teams
            for i, player in enumerate(players):
                if player.team not in single_game_teams:
                    prob += player_vars[i] == 0
                    
        else:
            # Regular FanDuel constraints
            for position, count in FANDUEL_POSITIONS.items():
                if position == 'FLEX':
                    flex_players = [i for i, p in enumerate(players) if p.position in ['RB', 'WR', 'TE']]
                    if flex_players:
                        prob += pulp.lpSum([player_vars[i] for i in flex_players]) >= count
                elif position == 'DST':
                    dst_players = [i for i, p in enumerate(players) if p.position in ['DST', 'DEF', 'D/ST']]
                    if dst_players:
                        prob += pulp.lpSum([player_vars[i] for i in dst_players]) == count
                else:
                    position_players = [i for i, p in enumerate(players) if p.position == position]
                    if position_players:
                        prob += pulp.lpSum([player_vars[i] for i in position_players]) == count
            
            # Total roster size
            total_required = sum(FANDUEL_POSITIONS.values())
            prob += pulp.lpSum([player_vars[i] for i in range(len(players))]) == total_required
        
        # Stacking constraints based on contest type
        if force_stacks and not single_game_teams:
            if contest_type == 'gpp':
                self._add_aggressive_stacking_constraints(prob, players, player_vars)
            elif contest_type == 'cash':
                # Light stacking for cash games
                self._add_conservative_stacking_constraints(prob, players, player_vars)
            elif contest_type == 'contrarian':
                self._add_unconventional_stacking_constraints(prob, players, player_vars)
        
        # Team diversity constraints
        team_counts = {}
        for i, player in enumerate(players):
            if player.team not in team_counts:
                team_counts[player.team] = []
            team_counts[player.team].append(i)
        
        max_per_team = 3 if contest_type == 'cash' else 4
        for team, player_indices in team_counts.items():
            prob += pulp.lpSum([player_vars[i] for i in player_indices]) <= max_per_team
    
    def _add_aggressive_stacking_constraints(self, prob, players: List[Player], player_vars: Dict):
        """Add aggressive stacking for tournaments"""
        teams_with_qb = set(p.team for p in players if p.position == 'QB')
        
        for team in teams_with_qb:
            qb_indices = [i for i, p in enumerate(players) if p.position == 'QB' and p.team == team]
            wr_te_indices = [i for i, p in enumerate(players) if p.position in ['WR', 'TE'] and p.team == team]
            
            # If QB selected, must select at least 2 pass catchers from same team
            if qb_indices and len(wr_te_indices) >= 2:
                for qb_idx in qb_indices:
                    prob += pulp.lpSum([player_vars[i] for i in wr_te_indices]) >= player_vars[qb_idx] * 2
    
    def _add_conservative_stacking_constraints(self, prob, players: List[Player], player_vars: Dict):
        """Add light stacking for cash games"""
        teams_with_qb = set(p.team for p in players if p.position == 'QB')
        
        for team in teams_with_qb:
            qb_indices = [i for i, p in enumerate(players) if p.position == 'QB' and p.team == team]
            wr_te_indices = [i for i, p in enumerate(players) if p.position in ['WR', 'TE'] and p.team == team]
            
            # If QB selected, encourage 1 pass catcher from same team (not required)
            if qb_indices and wr_te_indices:
                for qb_idx in qb_indices:
                    prob += pulp.lpSum([player_vars[i] for i in wr_te_indices]) >= player_vars[qb_idx] * 0.5
    
    def _add_unconventional_stacking_constraints(self, prob, players: List[Player], player_vars: Dict):
        """Add contrarian stacking logic"""
        # RB + DST from same team (game script correlation)
        teams_with_rb_dst = {}
        for player in players:
            if player.position in ['RB', 'DST']:
                if player.team not in teams_with_rb_dst:
                    teams_with_rb_dst[player.team] = {'RB': [], 'DST': []}
                teams_with_rb_dst[player.team][player.position].append(
                    next(i for i, p in enumerate(players) if p.id == player.id)
                )
        
        # If RB selected, slight preference for same team DST
        for team, positions in teams_with_rb_dst.items():
            if positions['RB'] and positions['DST']:
                for rb_idx in positions['RB']:
                    for dst_idx in positions['DST']:
                        # This would be implemented as a soft constraint in the objective
                        pass
    
    def _extract_lineup_result(self, prob, players: List[Player], player_vars: Dict, contest_type: str) -> LineupResult:
        """Extract optimization results with contest-specific metrics"""
        selected_players = []
        total_salary = 0
        total_ownership = 0
        
        for i, player in enumerate(players):
            if player_vars[i].varValue == 1:
                selected_players.append(player)
                total_salary += player.salary
                total_ownership += player.ownership
        
        # Calculate projected points based on format
        if contest_type == 'single_game' and len(selected_players) == 6:
            # Single Game: MVP gets 1.5x points
            selected_players.sort(key=lambda p: p.projection, reverse=True)
            mvp = selected_players[0]
            projected_points = mvp.projection * 1.5  # MVP multiplier
            projected_points += sum(p.projection for p in selected_players[1:])
        else:
            # Regular formats
            projected_points = sum(p.projection for p in selected_players)
        
        # Calculate ceiling and floor
        ceiling_score = sum(p.projection + p.variance for p in selected_players)
        floor_score = sum(max(0, p.projection - p.variance) for p in selected_players)
        
        # Single game MVP adjustments
        if contest_type == 'single_game' and len(selected_players) == 6:
            mvp = max(selected_players, key=lambda p: p.projection)
            ceiling_score = ceiling_score - mvp.projection + (mvp.projection * 1.5)
            floor_score = floor_score - mvp.projection + (mvp.projection * 1.5)
        
        # Calculate correlation score
        correlation_score = self._calculate_lineup_correlation(selected_players)
        
        # Calculate weather impact
        weather_impact = np.mean([p.weather_factor for p in selected_players])
        
        return LineupResult(
            players=selected_players,
            total_salary=total_salary,
            projected_points=projected_points,
            total_value=sum(p.value for p in selected_players),
            ownership_total=total_ownership,
            correlation_score=correlation_score,
            weather_impact=weather_impact,
            contest_type=contest_type,
            ceiling_score=ceiling_score,
            floor_score=floor_score
        )
    
    def _calculate_lineup_correlation(self, players: List[Player]) -> float:
        """Calculate overall lineup correlation score"""
        correlations = []
        
        for i, player1 in enumerate(players):
            for j, player2 in enumerate(players[i+1:], i+1):
                corr = self.correlation_matrix.get_correlation(player1, player2)
                if corr != 0:
                    correlations.append(abs(corr))
        
        return np.mean(correlations) if correlations else 0.0
    
    def generate_multiple_lineups(self, 
                                 players: List[Player], 
                                 num_lineups: int = 10,
                                 contest_type: str = 'gpp',
                                 single_game_teams: List[str] = None) -> List[LineupResult]:
        """Generate multiple diverse lineups with proper contest differentiation"""
        lineups = []
        excluded_combinations = set()
        
        # Contest-specific generation strategies
        if contest_type == 'cash':
            # Cash games: Generate fewer, more consistent lineups
            num_lineups = min(num_lineups, 5)
        elif contest_type == 'contrarian':
            # Contrarian: More diverse lineups with different ownership profiles
            num_lineups = min(num_lineups * 2, 20)
        
        for i in range(num_lineups):
            # Add randomization for diversity
            randomized_players = self._add_randomization(players.copy(), contest_type, i)
            
            lineup = self._optimize_with_exclusions(randomized_players, excluded_combinations, 
                                                   contest_type, single_game_teams)
            
            if lineup:
                lineups.append(lineup)
                
                # Add combination to exclusions for diversity
                player_combo = tuple(sorted([p.id for p in lineup.players]))
                excluded_combinations.add(player_combo)
                
                # Add core combinations (key players) for even more diversity
                if contest_type != 'cash':  # Cash games can have similar cores
                    key_players = sorted(lineup.players, key=lambda p: p.projection, reverse=True)[:3]
                    core_combo = tuple(sorted([p.id for p in key_players]))
                    excluded_combinations.add(core_combo)
            else:
                break
        
        # Sort lineups by contest-appropriate metric
        if contest_type == 'gpp' or contest_type == 'contrarian':
            lineups.sort(key=lambda x: x.ceiling_score, reverse=True)
        elif contest_type == 'cash':
            lineups.sort(key=lambda x: x.floor_score, reverse=True)
        else:
            lineups.sort(key=lambda x: x.projected_points, reverse=True)
        
        logger.info(f"Generated {len(lineups)} unique {contest_type} lineups")
        return lineups
    
    def _add_randomization(self, players: List[Player], contest_type: str, iteration: int) -> List[Player]:
        """Add controlled randomization to create lineup diversity"""
        randomized_players = []
        
        for player in players:
            adjusted_player = Player(
                id=player.id,
                name=player.name,
                position=player.position,
                team=player.team,
                salary=player.salary,
                projection=player.projection,
                ownership=player.ownership,
                weather_factor=player.weather_factor,
                injury_risk=player.injury_risk,
                value=player.value,
                variance=player.variance
            )
            
            # Contest-specific randomization
            if contest_type == 'gpp':
                # Tournament: More aggressive randomization for upside
                random_factor = random.uniform(0.95, 1.08)
                adjusted_player.projection *= random_factor
                
            elif contest_type == 'cash':
                # Cash: Minimal randomization, focus on consistency
                random_factor = random.uniform(0.98, 1.02)
                adjusted_player.projection *= random_factor
                
            elif contest_type == 'contrarian':
                # Contrarian: Heavy randomization to find unique builds
                random_factor = random.uniform(0.90, 1.15)
                adjusted_player.projection *= random_factor
                # Also randomize ownership to create different leverage spots
                ownership_factor = random.uniform(0.8, 1.2)
                adjusted_player.ownership *= ownership_factor
            
            # Recalculate value after randomization
            adjusted_player.value = adjusted_player.projection / (adjusted_player.salary / 1000)
            
            randomized_players.append(adjusted_player)
        
        return randomized_players
    
    def _optimize_with_exclusions(self, players: List[Player], excluded_combinations: set, 
                                contest_type: str, single_game_teams: List[str] = None) -> Optional[LineupResult]:
        """Optimize with exclusions for diversity"""
        try:
            prob = pulp.LpProblem("DFS_Diverse_Optimization", pulp.LpMaximize)
            
            player_vars = {}
            for i, player in enumerate(players):
                player_vars[i] = pulp.LpVariable(f"player_{i}", cat='Binary')
            
            # Objective function
            objective_terms = []
            for i, player in enumerate(players):
                points_value = self._calculate_contest_specific_value(player, contest_type, True)
                objective_terms.append(points_value * player_vars[i])
            
            prob += pulp.lpSum(objective_terms)
            
            # Standard constraints
            self._add_contest_specific_constraints(prob, players, player_vars, contest_type, 
                                                 True, single_game_teams)
            
            # Exclusion constraints for diversity
            for excluded_combo in excluded_combinations:
                if len(excluded_combo) <= len(players):
                    excluded_indices = []
                    for player_id in excluded_combo:
                        for i, player in enumerate(players):
                            if player.id == player_id:
                                excluded_indices.append(i)
                                break
                    
                    if len(excluded_indices) >= 2:  # Need at least 2 players to create meaningful exclusion
                        prob += pulp.lpSum([player_vars[i] for i in excluded_indices]) <= len(excluded_indices) - 1
            
            # Solve
            prob.solve(pulp.PULP_CBC_CMD(msg=0))
            
            if prob.status == pulp.LpStatusOptimal:
                return self._extract_lineup_result(prob, players, player_vars, contest_type)
            else:
                return None
                
        except Exception as e:
            logger.error(f"Error in diverse optimization: {e}")
            return None
    
    def export_lineups_to_csv(self, lineups: List[LineupResult], filename: str = None):
        """Export lineups to CSV with proper formatting"""
        if not filename:
            filename = f"lineups_{pd.Timestamp.now().strftime('%Y%m%d_%H%M%S')}.csv"
        
        lineup_data = []
        
        for i, lineup in enumerate(lineups):
            lineup_row = {'Lineup': i + 1}
            
            # Handle single game format differently
            if lineup.contest_type == 'single_game' and len(lineup.players) == 6:
                # Single Game: MVP + 5 FLEX
                sorted_players = sorted(lineup.players, key=lambda p: p.projection, reverse=True)
                lineup_row['MVP'] = f"{sorted_players[0].name} ({sorted_players[0].id})"
                
                for j in range(5):
                    if j + 1 < len(sorted_players):
                        lineup_row[f'FLEX{j+1}'] = f"{sorted_players[j+1].name} ({sorted_players[j+1].id})"
                    else:
                        lineup_row[f'FLEX{j+1}'] = ""
                        
            else:
                # Regular FanDuel format
                by_position = {}
                for player in lineup.players:
                    pos = player.position
                    if pos in ['DST', 'DEF']:
                        pos = 'D'
                    if pos not in by_position:
                        by_position[pos] = []
                    by_position[pos].append(player)
                
                # Fill standard positions
                positions_order = ['QB', 'RB', 'WR', 'TE', 'FLEX', 'D']
                for pos in positions_order:
                    if pos == 'RB' and 'RB' in by_position:
                        lineup_row['RB'] = f"{by_position['RB'][0].name} ({by_position['RB'][0].id})" if len(by_position['RB']) >= 1 else ""
                        lineup_row['RB2'] = f"{by_position['RB'][1].name} ({by_position['RB'][1].id})" if len(by_position['RB']) >= 2 else ""
                    elif pos == 'WR' and 'WR' in by_position:
                        lineup_row['WR'] = f"{by_position['WR'][0].name} ({by_position['WR'][0].id})" if len(by_position['WR']) >= 1 else ""
                        lineup_row['WR2'] = f"{by_position['WR'][1].name} ({by_position['WR'][1].id})" if len(by_position['WR']) >= 2 else ""
                        lineup_row['WR3'] = f"{by_position['WR'][2].name} ({by_position['WR'][2].id})" if len(by_position['WR']) >= 3 else ""
                    elif pos == 'FLEX':
                        # Find FLEX player (unused RB/WR/TE)
                        used_players = []
                        # Add used RBs and WRs
                        if 'RB' in by_position:
                            used_players.extend(by_position['RB'][:2])
                        if 'WR' in by_position:
                            used_players.extend(by_position['WR'][:3])
                        if 'TE' in by_position:
                            used_players.extend(by_position['TE'][:1])
                        
                        # Find FLEX
                        flex_player = None
                        for flex_pos in ['RB', 'WR', 'TE']:
                            if flex_pos in by_position:
                                for player in by_position[flex_pos]:
                                    if player not in used_players:
                                        flex_player = player
                                        break
                                if flex_player:
                                    break
                        
                        lineup_row['FLEX'] = f"{flex_player.name} ({flex_player.id})" if flex_player else ""
                    elif pos in by_position and by_position[pos]:
                        lineup_row[pos] = f"{by_position[pos][0].name} ({by_position[pos][0].id})"
                    else:
                        lineup_row[pos] = ""
            
            # Add summary stats
            lineup_row.update({
                'Contest_Type': lineup.contest_type,
                'Total_Salary': lineup.total_salary,
                'Projected_Points': round(lineup.projected_points, 2),
                'Ceiling': round(lineup.ceiling_score, 2),
                'Floor': round(lineup.floor_score, 2),
                'Ownership_Total': round(lineup.ownership_total, 1),
                'Correlation_Score': round(lineup.correlation_score, 3)
            })
            
            lineup_data.append(lineup_row)
        
        df = pd.DataFrame(lineup_data)
        df.to_csv(filename, index=False)
        logger.info(f"Exported {len(lineups)} {lineups[0].contest_type if lineups else 'unknown'} lineups to {filename}")
        return filename

# Enhanced utility function for external use
def optimize_dfs_lineups(player_data: List[Dict], 
                        weather_data: Dict = None,
                        num_lineups: int = 10,
                        contest_type: str = 'gpp',
                        single_game_teams: List[str] = None) -> List[LineupResult]:
    """Enhanced main entry point for lineup optimization with proper contest differentiation"""
    optimizer = EnhancedDFSOptimizer()
    players = optimizer.prepare_players(player_data, weather_data)
    
    if not players:
        logger.error("No valid players for optimization")
        return []
    
    # Log contest type for debugging
    logger.info(f"Optimizing {num_lineups} lineups for contest type: {contest_type}")
    if single_game_teams:
        logger.info(f"Single game teams: {single_game_teams}")
    
    return optimizer.generate_multiple_lineups(players, num_lineups, contest_type, single_game_teams)
